<Window x:Class="HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:keyboardmgr2"
        mc:Ignorable="d"
        Background="{DynamicResource backgroundColor1}"
        Title="键鼠管家帮助与信息显示器" Height="550" Width="600" MinWidth="550" MinHeight="600">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Label x:Name="HelpTheme" Content="(帮助主题)" FontSize="23" FontWeight="Light"/>
            <ToggleButton x:Name="FontButton" Style="{DynamicResource topmostButtonStyle}"
                          FontFamily="iconFont" Content="大字体" HorizontalAlignment="Right"
                          Height="36" Width="43" Click="ToggleButton_Click"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <TextBlock x:Name="HelpText" TextWrapping="WrapWithOverflow"
                       Text="显示帮助与信息时出错，可能是LCS的开发人猿忘记添加内容了呢！"/>
        </ScrollViewer>
    </Grid>
</Window>
