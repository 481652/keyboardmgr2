<Window x:Class="ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:keyboardmgr2"
		WindowStartupLocation="Manual"
		ShowInTaskbar="False" ShowActivated="False"
		ResizeMode="NoResize" 
		WindowStyle="None"
		MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave" Loaded="Window_Loaded"
        mc:Ignorable="d"
		Background="{DynamicResource backgroundColor1}"
        Title="ClipboardWindow" Height="450" Width="200">
	<StackPanel>
		<Border BorderBrush="{DynamicResource backgroundColor1}">

		</Border>
	</StackPanel>
</Window>
