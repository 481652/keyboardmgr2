<Window x:Class="FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:keyboardmgr2"        
        mc:Ignorable="d"
        Title="键鼠管家悬浮窗" 
		Height="50" Width="800" 
		ResizeMode="NoResize" 
		ShowInTaskbar="False" ShowActivated="False" WindowStyle="None" Loaded="Window_Loaded"
        Closing="Window_Closing" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave" AllowsTransparency="False"
        Background="{DynamicResource backgroundColor1}">
    <Border x:Name="AnimatedBorder"
            CornerRadius="8"
            BorderBrush="{DynamicResource ButtonBorderColor}"
            BorderThickness="1"
            Background="{DynamicResource backgroundColor1}">
        <Grid Margin="6,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>

            <Image Margin="1,2" Source="/appiconnew.ico" MouseUp="Image_MouseUp"/>
			<Label x:Name="titleLabel" Grid.Column="1" Content="键鼠管家" FontSize="18"
                   VerticalAlignment="Center" FontFamily="Microsoft YaHei UI Light"/>
			<Button x:Name="clickButton" Grid.Column="2" Style="{DynamicResource DefaultButton}"
                    FontFamily="{DynamicResource iconFont}" FontSize="18" Content="{DynamicResource Icon.Click}"
                    Height="40" Width="40" Click="ClickButton_Click" BorderBrush="{x:Null}" Background="{x:Null}"/>
            <Button x:Name="sendButton" Grid.Column="3" Style="{DynamicResource DefaultButton}"
                    FontFamily="{DynamicResource iconFont}" FontSize="18" Content="{DynamicResource Icon.Send}"
                    Height="40" Width="40" Click="SendButton_Click" BorderBrush="{x:Null}"
                    Background="{x:Null}" ToolTip="打开列表连发"/>
            <Button x:Name="recordButton" Grid.Column="4" Style="{DynamicResource DefaultButton}"
                    FontFamily="{DynamicResource iconFont}" FontSize="18" Content="{DynamicResource Icon.Record}"
                    Height="40" Width="40" Click="RecordButton_Click" BorderBrush="{x:Null}"
                    Background="{x:Null}" ToolTip="打开录制"/>
            <Button x:Name="scriptButton" Grid.Column="5" Style="{DynamicResource DefaultButton}"
                    FontFamily="{DynamicResource iconFont}" FontSize="18" Content="{DynamicResource Icon.Script}"
                    Height="40" Width="40" Click="ScriptButton_Click" BorderBrush="{x:Null}"
                    Background="{x:Null}" ToolTip="打开脚本"/>
            <Button x:Name="stopButton" Grid.Column="6" Style="{DynamicResource DefaultButton}"
                    FontFamily="{DynamicResource iconFont}" FontSize="18" Content="{DynamicResource Icon.Stop}"
                    Height="40" Width="40" Click="StopButton_Click" BorderBrush="{x:Null}"
                    Visibility="Hidden" Background="{x:Null}"/>
            <Button Grid.Column="7" Style="{DynamicResource DefaultButton}"
                    FontFamily="{DynamicResource iconFont}" FontSize="18" Content="{DynamicResource Icon.Close}"
                    Height="40" Width="40" Click="Button_Click" BorderBrush="{x:Null}" Background="{x:Null}"/>
        </Grid>
    </Border>
</Window>
