<Window x:Class="expWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:keyboardmgr2"
        mc:Ignorable="d"
        Background="{DynamicResource backgroundColor1}" Title="错误" Height="415" Width="500" WindowStyle="ToolWindow" ResizeMode="NoResize" Closing="Window_Closing">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="62*"/>
            <RowDefinition Height="353*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0"
            Margin="10,10,10,8"
            Content="程序运行时遇到严重错误。"  
               
            FontSize="23"  
            FontWeight="Light" />
        <TextBlock x:Name="TextBlock1"
            TextWrapping="Wrap" 
            VerticalAlignment="Top" 
            Height="261" 
            Margin="22,49,32,0" FontFamily="Microsoft YaHei UI" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.RowSpan="2"><Run Text=""/></TextBlock>
        <Button Style="{DynamicResource DefaultButton}" Content="退出" HorizontalAlignment="Left" Margin="385,258,0,0" Grid.Row="1" VerticalAlignment="Top" Height="43" Width="93" Click="Button_Click"/>
        <Button x:Name="CopyButton" Style="{DynamicResource DefaultButton}" FontFamily="{DynamicResource iconFont}" FontSize="16" Content="{DynamicResource Icon.Copy}" HorizontalAlignment="Left" Margin="22,263,0,0" Grid.Row="1" VerticalAlignment="Top" Height="33" Width="40" Click="CopyButton_Click"/>
        <Popup x:Name="MyPopup" HorizontalAlignment="Left" PlacementTarget ="{Binding ElementName=CopyButton}" VerticalAlignment="Top" StaysOpen="False" Width="50" Height="70">
            <Grid Background="{DynamicResource ButtonBackgroundColor}" Height="30" Width="70">
                <Label Content="已复制！" FontSize="12" />
            </Grid>
        </Popup>



    </Grid>
</Window>
